# ============================================================
#  fgPROMS benchmark: batch heater with two phases (TASK)
#  Phase "Heat" (t = 0..10):  heating rate 2000/(m*cp)
#  Phase "Cool" (t = 10..20): cooling rate -1000/(m*cp)
#  Analytical:
#    T(10) = 300 + 10*2000/(10*4200) = 300.47619
#    T(20) = 300.47619 - 10*1000/(10*4200) = 300.23810
# ============================================================
MODEL BatchHeater
  PARAMETER
    m  AS REAL DEFAULT 10.0      # kg
    cp AS REAL DEFAULT 4200.0    # J/kg/K
  VARIABLE
    T AS REAL
  TASK
    PHASE Heat
      $T = 2000 / (m * cp) ;
    END
    PHASE Cool
      $T = -1000 / (m * cp) ;
    END
  END
  INITIAL
    T = 300.0 ;
  SCHEDULE
    SEQUENCE
      CONTINUE FOR t := 0 TO 10 WITH Heat STEP 0.1
      CONTINUE FOR t := 10 TO 20 WITH Cool STEP 0.1
    END
END
