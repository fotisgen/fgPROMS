# ============================================================
#  fgPROMS benchmark: dynamic diffusion (distributed)
#  dT/dt = alpha * d2T/dz2,  T(0)=T(L)=0,  T(z,0)=100
#  Late-time solution: fundamental Fourier mode
#    T(z,t) ~ (400/pi) * sin(pi*z/L) * exp(-alpha*pi^2*t/L^2)
#  Verified in the tests against this analytical mode.
# ============================================================
MODEL Diffusion
  PARAMETER
    L     AS REAL DEFAULT 1.0
    alpha AS REAL DEFAULT 0.1
  DISTRIBUTION
    Axial : L : 21 ;
  VARIABLE
    T AS DISTRIBUTION(Axial) OF REAL
  EQUATION
    $T = alpha * PARTIAL(T, Axial, Axial) ;
  INITIAL
    T = 100.0 ;
  BOUNDARY
    T = 0 AT Axial = 0 ;
    T = 0 AT Axial = L ;
  SCHEDULE
    SEQUENCE
      CONTINUE FOR t := 0 TO 10 STEP 0.05
    END
END
