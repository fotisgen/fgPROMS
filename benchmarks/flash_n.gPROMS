# ============================================================
#  fgPROMS benchmark: N-component flash with SIGMA
#  Rachford-Rice as a sum over components:
#      SUM_i  z(i)*(K(i)-1) / (1 + V*(K(i)-1)) = 0
#  Reference (bisection in the tests): V ~ 0.3077
# ============================================================
MODEL FlashN
  PARAMETER
    N  AS REAL DEFAULT 3
    z  AS ARRAY(3) OF REAL
    K  AS ARRAY(3) OF REAL
  VARIABLE
    V AS REAL DEFAULT 0.5
  EQUATION
    SIGMA(z(i) * (K(i) - 1) / (1 + V * (K(i) - 1)), i, 1, N) = 0 ;
  SET
    z(1) := 0.40 ; z(2) := 0.35 ; z(3) := 0.25 ;
    K(1) := 3.0 ;  K(2) := 0.6 ;  K(3) := 0.05 ;
END
